# EcoPulse — Git Ignore Configuration
# Protects secrets, API keys, credentials, local databases, and temporary build artifacts

# 1. Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets.json
credentials.json
token.json
api_keys.json

# 2. IoT Hardware & Wi-Fi Credentials
wifi_config.*
wpa_supplicant.conf
device_credentials.*
hardware_keys.*

# 3. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env/
ENV/

# 4. SQLite Transient WAL Files & Temporary DBs
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.db-journal
test_*.db

# 5. Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

# 6. IDEs & OS Files
.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
.system_generated/
*.log

# Note: ecopulse.db and ecopulse_model.joblib can be committed as pre-trained baseline assets,
# or kept local if using dedicated persistent volumes in production.
