# ==============================================================================
# EcoPulse — Environment Configuration Template (.env.example)
# Duplicate this file to .env and configure for your local or cloud environment.
# DO NOT commit real secrets or credentials to public source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Networking Configuration
# ------------------------------------------------------------------------------
# Port the Flask REST API server will listen on (default: 5000)
# Cloud platforms (Render, Railway, Fly.io, Heroku) inject this automatically.
PORT=5000

# Host binding address
# Use '127.0.0.1' for strictly local execution, or '0.0.0.0' for Docker/Cloud containers.
HOST=0.0.0.0

# Environment mode: 'development' or 'production'
ENVIRONMENT=production

# Application Secret Key (for session signing / CSRF security)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ecopulse-hackathon-demo-key-change-in-production

# ------------------------------------------------------------------------------
# 2. CORS (Cross-Origin Resource Sharing) Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of permitted frontend origins.
# Use '*' during hackathon demos, or specify exact frontend URLs in production.
# Example: https://ecopulse.vercel.app,https://ecopulse.netlify.app
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. Persistent Database Configuration (SQLite)
# ------------------------------------------------------------------------------
# Path to SQLite database file.
# In cloud deployments with persistent volumes, point this to the mounted volume path.
# Render Persistent Disk example: /var/data/ecopulse.db
# Fly.io Volume example: /mnt/data/ecopulse.db
# Local default: ecopulse.db
DATABASE_PATH=ecopulse.db

# ------------------------------------------------------------------------------
# 4. Machine Learning & Model Settings
# ------------------------------------------------------------------------------
# Path to pre-trained IsolationForest joblib model bundle
MODEL_PATH=ecopulse_model.joblib

# Anomaly threshold calibration (0.0 to 1.0, default: 0.65)
ANOMALY_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 5. Municipal Tariff & Sustainability Benchmarks
# ------------------------------------------------------------------------------
# Cost benchmark per liter in USD (default: $0.0035 / Liter, ~$3.50 / m³)
TARIFF_PER_LITER=0.0035
